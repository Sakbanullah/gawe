# Gawe — contoh environment. Development only.
#
# PENTING: aplikasi tidak memuat file ini secara otomatis.
# Tidak ada `python-dotenv` di dependency dan tidak ada `load_dotenv` di kode.
# File ini hanya dokumentasi variabel yang dibaca dari environment OS.
#
# Cara pakai (PowerShell, sesi terminal saja):
#     $env:GAWE_DB_PASSWORD = "..."
#     backend\.venv\Scripts\python.exe -m gawe.cli serve
#
# Konfigurasi utama ada di `config.toml`. Secret tidak pernah ditulis di file
# ini, di `config.toml`, atau di commit. Secret produksi disimpan di Windows
# Credential Manager melalui keyring.
#
# C6 selesai 2026-10-19: file ini berada di root repository.

# ---------------------------------------------------------------------------
# Database (dibaca lewat `password_env` di config.toml, default nama ini)
# ---------------------------------------------------------------------------
# Password MySQL lokal. Kosongkan bila user root tidak memakai password.
# Nilai tidak pernah ditulis ke log atau ke config.
GAWE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Fallback development saja. Keyring lebih diutamakan: bila
# `api_key_ref` di config.toml menunjuk entri keyring yang terisi, nilai itu
# yang dipakai dan variabel ini diabaikan.
#
# Referensi keyring BUKAN variabel environment: atur lewat `api_key_ref`
# pada `[llm.providers.<id>]` di config.toml.
GAWE_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Path opsional
# ---------------------------------------------------------------------------
# Lokasi file config. Default: `config.toml` di root repository.
# GAWE_CONFIG=config.toml

# Binary Tectonic untuk kompilasi PDF. Bila kosong, kode mencari di PATH lalu
# di %LOCALAPPDATA%\Gawe\tectonic\tectonic.exe.
# GAWE_TECTONIC=%LOCALAPPDATA%\Gawe\tectonic\tectonic.exe

# ---------------------------------------------------------------------------
# Test (opsional)
# ---------------------------------------------------------------------------
# Target MySQL untuk test. Default: 127.0.0.1:3306, user root.
# Test memakai satu schema tetap `gawe_test_main` yang dipakai ulang antar run,
# bukan schema acak per sesi. Isolasi antar test dijamin TRUNCATE.
# Isi `GAWE_TEST_SCHEMA` hanya bila butuh nama lain, misalnya saat dua run
# paralel. Nama wajib berawalan `gawe_test_` agar boleh di-DROP.
# GAWE_TEST_DB_HOST=127.0.0.1
# GAWE_TEST_DB_PORT=3306
# GAWE_TEST_DB_USER=root
# GAWE_TEST_SCHEMA=gawe_test_main

# Test live provider bersifat opt-in. Tanpa dua variabel ini, test live di-skip.
# GAWE_LIVE_9ROUTER=1
# GAWE_LIVE_CONFIG=D:\gawe\config.toml
