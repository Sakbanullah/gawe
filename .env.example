# Gawe — contoh environment. Development only.
#
# Secret produksi disimpan di Windows Credential Manager melalui keyring.
# Jangan isi nilai rahasia di file ini.
#
# C6 selesai 2026-10-19: file ini berada di root repository.

# Nama referensi keyring, bukan nilai secret.
GAWE_LLM_API_KEY_REF=gawe/llm/provider_a

# Fallback development saja. Kosongkan.
GAWE_LLM_API_KEY=

# Port runtime contoh; port final belum ditetapkan.
GAWE_PORT=8000

# Password MySQL lokal. Isi hanya di environment atau config.toml lokal.
# Jangan commit nilainya.
GAWE_DB_PASSWORD=
