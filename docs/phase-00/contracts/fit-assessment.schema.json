{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawe.local/schemas/phase-00/fit-assessment.schema.json",
  "title": "Gawe Fit Assessment",
  "description": "Hasil fit score. Hanya sah untuk lowongan berstatus eligible. Tidak memuat eligibility_status atau priority_tier. Bobot dan ambang adalah rancangan awal dan belum dikalibrasi.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "job_posting_version_id",
    "profile_version_id",
    "fit_score",
    "verdict",
    "confidence",
    "components",
    "gaps",
    "status_outdated",
    "computed_at"
  ],
  "properties": {
    "assessment_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "job_posting_version_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "profile_version_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "fit_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "verdict": {
      "type": "string",
      "enum": ["strong", "moderate", "weak"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight", "value", "contribution"],
        "properties": {
          "name": {
            "type": "string",
            "enum": ["must_coverage", "nice_coverage", "experience_fit"]
          },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "value": { "type": "number", "minimum": 0, "maximum": 1 },
          "contribution": { "type": "number", "minimum": 0, "maximum": 100 },
          "requirement_ids": {
            "type": "array",
            "maxItems": 200,
            "items": { "type": "string" }
          },
          "evidence_ids": {
            "type": "array",
            "maxItems": 200,
            "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "description"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence_ids": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_-]+$" }
          }
        }
      }
    },
    "status_outdated": { "type": "boolean" },
    "outdated_reason": { "type": ["string", "null"], "maxLength": 1000 },
    "computed_at": { "type": "string", "format": "date-time" }
  }
}
