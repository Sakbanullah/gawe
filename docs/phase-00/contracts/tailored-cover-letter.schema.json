{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gawe.local/schemas/phase-00/tailored-cover-letter.schema.json",
  "title": "Gawe Tailored Cover Letter Content",
  "description": "Bentuk konten cover letter yang dihasilkan role `write`. Harus identik dengan keluaran draft._cover_letter() karena render.py, factcheck.py, diff_against_profile, dan export_service membaca bentuk ini. Field `missing` tidak diisi model; service menghitungnya lewat draft.missing_information().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "language",
    "target",
    "header",
    "greeting",
    "paragraphs",
    "signoff",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "cover_letter" },
    "language": { "type": "string", "enum": ["en", "id"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "job_posting_version_id", "title", "company"],
      "properties": {
        "job_id": { "type": ["string", "null"], "maxLength": 64 },
        "job_posting_version_id": { "type": ["string", "null"], "maxLength": 64 },
        "title": { "type": ["string", "null"], "maxLength": 300 },
        "company": { "type": ["string", "null"], "maxLength": 300 }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "email", "phone", "location", "links"],
      "properties": {
        "full_name": { "type": ["string", "null"], "maxLength": 200 },
        "email": { "type": ["string", "null"], "maxLength": 200 },
        "phone": { "type": ["string", "null"], "maxLength": 60 },
        "location": { "type": ["string", "null"], "maxLength": 200 },
        "links": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "greeting": { "type": "string", "minLength": 1, "maxLength": 300 },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "evidence_ids"],
        "properties": {
          "kind": { "type": "string", "enum": ["intent", "claim"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "evidence_ids": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "signoff": { "type": "string", "minLength": 1, "maxLength": 100 },
    "signature": { "type": ["string", "null"], "maxLength": 200 },
    "gaps": {
      "type": "array",
      "maxItems": 50,
      "description": "Requirement lowongan tanpa bukti. Dibuang sebelum konten disimpan; hanya dilaporkan.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "question"],
        "properties": {
          "requirement": { "type": "string", "minLength": 1, "maxLength": 500 },
          "question": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
